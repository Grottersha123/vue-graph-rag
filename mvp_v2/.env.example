# uv environment used by the documented launch command
UV_PROJECT_ENVIRONMENT=/tmp/vue-graph-rag-mvp-v2/.venv

# Runtime paths. Run commands from the repository root.
MVP_V2_WORKING_ROOT=mvp_v2/runtime/mvp_data
MVP_V2_DUMPS_ROOT=mvp_v2/runtime/dumps
MVP_V2_DATABASES_ROOT=mvp_v2/runtime/databases
MVP_V2_LADYBUG_HOME=mvp_v2/runtime/ladybug-home

# Loopback Ollama by default. For accepted LAN debugging risk, set the exact
# comma-separated private hostname allowlist separately from the base URL.
MVP_V2_OLLAMA_BASE_URL=http://127.0.0.1:11434
MVP_V2_OLLAMA_ALLOWED_LAN_HOSTS=
MVP_V2_VISION_MODEL=
MVP_V2_VISION_MODEL_VERSION=
MVP_V2_EMBEDDING_MODEL=
MVP_V2_EMBEDDING_MODEL_VERSION=
MVP_V2_EMBEDDING_DIMENSION=768
MVP_V2_MINIMUM_SIMILARITY_SCORE=0.55
MVP_V2_CHAT_MODEL=
MVP_V2_CHAT_MODEL_VERSION=
MVP_V2_EVIDENCE_LIMIT=8

# Local FastAPI/Telegram gateway. Loopback URLs are local-only defaults and are
# not suitable for exposing services directly to an untrusted network.
MVP_V2_DATABASE_NAME=
MVP_V2_GATEWAY_LOG_DIRECTORY=mvp_v2/runtime/logs/gateway
MVP_V2_LOG_LEVEL=ERROR
MVP_V2_REDIS_URL=redis://127.0.0.1:6379/0
MVP_V2_BACKEND_URL=http://127.0.0.1:8000
MVP_V2_OLLAMA_TIMEOUT_SECONDS=120
MVP_V2_TOTAL_CONCURRENCY=6
MVP_V2_MODEL_CONCURRENCY=2
MVP_V2_FEEDBACK_TTL_SECONDS=900
MVP_V2_SESSION_INACTIVITY_SECONDS=3600
TELEGRAM_ALLOWED_USER_IDS=

# gateway_token authenticates Telegram-to-backend requests. Compose reads the
# preferred mode-0600 files below. For local non-Compose runs, set either the
# direct value or its *_FILE alternative, never both. Keep all real secrets out
# of git and logs.
MVP_V2_BACKEND_TOKEN=
MVP_V2_BACKEND_TOKEN_FILE=mvp_v2/secrets/gateway_token
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_TOKEN_FILE=mvp_v2/secrets/telegram_bot_token

# Selora is optional. Configure both URL and key to make it the primary
# generation provider. HTTPS is required except for loopback-only development.
MVP_V2_SELORA_URL=
MVP_V2_SELORA_MODEL=
MVP_V2_SELORA_API_KEY=
MVP_V2_SELORA_API_KEY_FILE=
