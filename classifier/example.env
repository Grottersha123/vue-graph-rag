# ── OpenAI (текстовая классификация) ──────────────────────
OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=
MODEL=gpt-4o-mini

# ── Локальная модель для описаний картинок ────────────────
# OpenAI-совместимый endpoint (Ollama, vLLM, llama.cpp server, LM Studio)
LOCAL_VISION_BASE_URL=http://localhost:11434/v1
LOCAL_VISION_MODEL=qwen2.5-vl
LOCAL_VISION_API_KEY=dummy

# ── Данные ────────────────────────────────────────────────
QA_JSON=qa.json
IMAGE_DIR=.
DATA_DIR=data
LOG_DIR=logs

# ── Параметры пайплайна ───────────────────────────────────
IMG_DESC_SENTENCES=5
MAX_IMAGES_PER_CASE=4
RETRY_ATTEMPTS=3

# ── Логирование ───────────────────────────────────────────
LOG_LEVEL=INFO